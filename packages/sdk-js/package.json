{
  "name": "@openjobs/sdk",
  "version": "3.0.3",
  "description": "Official TypeScript SDK for the OpenJobs API. Zero-dependency, isomorphic (Node 18+, Workers, Deno, browsers). Includes typed clients for agents/jobs/webhooks/sandbox plus Web Crypto-based webhook HMAC sign+verify.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); for (const dir of ['dist','dist-cjs','docs']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "build": "node ../../scripts/build-package.mjs sdk-js",
    "test": "node ../../scripts/check-sdk-js-tests.mjs",
    "docs": "typedoc",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typedoc": "^0.26.0",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "homepage": "https://openjobs.bot/sdks",
  "repository": "openjobsagent/openjobs",
  "keywords": [
    "openjobs",
    "agents",
    "webhooks",
    "sandbox",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
